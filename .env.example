# Backend-v2 로컬 개발용 환경변수 예시.
#
# 사용법: 이 파일을 `.env`로 복사한 뒤 값을 채운다.
#   cp .env.example .env
# `.env`는 gitignore 대상이며, `bootRun`이 자동으로 주입한다(`source .env` 불필요).
# 여기 없는 키(JWT_PRIVATE_KEY, OAuth, Firebase, server.port 등)는
# `src/main/resources/application-secret.yml`에서 온다.
#
# 아래 값은 전부 application.yml의 기본값과 같으므로, 로컬 docker 스택을
# 그대로 쓴다면 MinIO 블록만 채우면 된다.

# ── MinIO (프로필 이미지 업로드) ─────────────────────────────────────────
# 로컬 docker 컨테이너(minio, 9000/9001)를 Community와 공유한다.
# 주의: 로컬 컨테이너의 루트 계정이 application.yml 기본값(minioadmin)과 다르므로, 그대로 두면
#       "The Access Key Id you provided does not exist" 로 인증에 실패한다.
# 버킷은 앱 기동 시 자동 생성되지만, 브라우저에서 이미지를 조회하려면
# 익명 읽기 정책을 한 번 걸어줘야 한다(안 그러면 403):
#   mc anonymous set download <alias>/planmate/profile
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=
MINIO_BUCKET=planmate
MINIO_PUBLIC_URL=http://localhost:9000

# ── PostgreSQL ───────────────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/planmate
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# ── PostgreSQL: 공공데이터(TourAPI) 캐시 DB (읽기 전용 2번째 DataSource) ──
# 앱 DB 와 별개 인스턴스. 스키마는 앱이 관리 안 함(pg_restore + 최신화 잡).
# 로컬은 docker-compose.local.yml 의 tourdata-postgres(5433) 기본값으로 자동 동작 — 아래는 운영/오버라이드용.
TOURDATA_DATASOURCE_URL=jdbc:postgresql://localhost:5433/tourdata
TOURDATA_DATASOURCE_USERNAME=postgres
TOURDATA_DATASOURCE_PASSWORD=

# ── planmate-ai (AI 챗봇 서버) ───────────────────────────────────────────
# 별도 repo/VM. AI_INTERNAL_TOKEN 은 planmate-ai .env 의 INTERNAL_SHARED_SECRET 과 동일해야 함.
# 운영: AI_BASE_URL 은 내부망 주소로만(public 노출 금지).
AI_BASE_URL=http://localhost:8010
AI_INTERNAL_TOKEN=dev-secret

# ── Redis ────────────────────────────────────────────────────────────────
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
REDIS_PASSWORD=
# Sentinel 구성을 쓸 때만 채운다(로컬은 보통 비워둔다).
SPRING_DATA_REDIS_SENTINEL_MASTER=
SPRING_DATA_REDIS_SENTINEL_NODES=

# ── 메일 (hiworks SMTP) ──────────────────────────────────────────────────
# 비워두면 메일 발송만 실패하고 기동에는 지장이 없다.
MAIL_USERNAME=
MAIL_PASSWORD=

# ── 외부 API ─────────────────────────────────────────────────────────────
ODSAY_API_KEY=

# ── Firebase (푸시 알림) ─────────────────────────────────────────────────
# 경로 또는 JSON 문자열 중 하나만 준다. 둘 다 비우면 푸시가 비활성화된다.
#
# 알림 센터로의 전환이 끝나면 이 값들은 필요 없어진다 — FCM 기기 토큰과 전송은
# Notification 서비스가 소유한다. cutover 전까지는 기존 경로가 살아 있어야 하므로 남긴다.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── 알림 outbox → Kafka ──────────────────────────────────────────────────
# 일정 초대/편집권한 요청 이벤트를 알림 센터로 흘려보내는 브로커.
# 브로커는 Notification 스택이 소유한다(Notification/deploy/docker-compose.notification.yml).
# 운영에서는 kafka:9092. 로컬에 브로커가 없으면 초대 자체는 성공하고 outbox 에만 쌓인다.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── 그 외 ────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=local
# Community 서버와 주고받는 내부 호출 토큰. 양쪽 값이 같아야 한다.
# 내부 API/gRPC 공유 비밀. 기본값이 없으므로 반드시 채워야 기동한다.
#   openssl rand -hex 32
# Backend-v2 / Community / Social 이 같은 값을 써야 한다.
INTERNAL_API_TOKEN=
# WebSocket(SharedSync) allowed-origins도 이 값을 공유한다.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# RS256 서명용 PKCS#8 개인키. 없으면 기동하지 않는다(JwtSigningKeys).
#   ./deploy/gen-jwt-key.sh
# 여러 줄 PEM 을 한 줄로 접어 넣어도 된다(\n 을 앱이 풀어준다).
JWT_PRIVATE_KEY=
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800
# SNS(OAuth) refresh_token 암호화 키(AES-256, Base64). 없으면 기동하지 않는다(SnsRefreshTokenCipher).
#   openssl rand -base64 32
SNS_REFRESH_TOKEN_ENC_KEY=
