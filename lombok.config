config.stopBubbling = true

# @RequiredArgsConstructor 등 Lombok 생성 생성자는 기본적으로 필드의 @Qualifier를
# 파라미터로 복사하지 않는다 - 같은 타입 빈이 여러 개일 때(RestTemplate 등) 의도한
# 빈이 아니라 이름이 우연히 겹치는 다른 빈이 조용히 주입되는 문제로 이어진다
# (project_ai/04_기능/날씨/A_추천_조회.md 구현 중 실측 확인).
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
